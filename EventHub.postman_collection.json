{
  "info": {
    "name": "EventHub Nepal API",
    "description": "Collection for testing the EventHub backend APIs. Set the 'token' variable after logging in.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "url": "{{baseUrl}}/login"
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/logout"
      }
    },
    {
      "name": "Get Dashboard Stats",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/dashboard"
      }
    },
    {
      "name": "Get All Events",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/events"
      }
    },
    {
      "name": "Get Event By Id",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/events/1"
      }
    },
    {
      "name": "Create Event",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_name\": \"Test Event\",\n  \"description\": \"Testing from Postman\",\n  \"event_date\": \"2026-09-30\",\n  \"event_time\": \"18:00\",\n  \"location\": \"Thamel\"\n}"
        },
        "url": "{{baseUrl}}/events"
      }
    },
    {
      "name": "Update Event",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_name\": \"Updated Event Name\",\n  \"description\": \"Updated description\",\n  \"event_date\": \"2026-09-30\",\n  \"event_time\": \"19:00\",\n  \"location\": \"Thamel\"\n}"
        },
        "url": "{{baseUrl}}/events/1"
      }
    },
    {
      "name": "Delete Event",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/events/1"
      }
    },
    {
      "name": "Get All Attendees",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/attendees"
      }
    },
    {
      "name": "Get Attendee By Id",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/attendees/1"
      }
    },
    {
      "name": "Create Attendee",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Attendee\",\n  \"email\": \"test.attendee@gmail.com\",\n  \"phone\": \"9800000000\"\n}"
        },
        "url": "{{baseUrl}}/attendees"
      }
    },
    {
      "name": "Update Attendee",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Name\",\n  \"email\": \"test.attendee@gmail.com\",\n  \"phone\": \"9811111111\"\n}"
        },
        "url": "{{baseUrl}}/attendees/1"
      }
    },
    {
      "name": "Delete Attendee",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/attendees/1"
      }
    },
    {
      "name": "Register Attendee For Event",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": 1,\n  \"attendee_id\": 2\n}"
        },
        "url": "{{baseUrl}}/register"
      }
    }
  ]
}
